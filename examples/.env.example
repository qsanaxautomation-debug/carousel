# Contoh konfigurasi
#
# File ini hanya contoh. Salin ke `.env` kalau Anda memakai docker-compose
# atau menjalankan n8n dari environment variable. Kalau konfigurasi diisi
# lewat UI n8n (credential), Anda TIDAK perlu file ini.
#
# JANGAN commit file `.env` yang berisi nilai asli.

# ─── n8n ──────────────────────────────────────────────────────────────────
GENERIC_TIMEZONE=Asia/Jakarta
TZ=Asia/Jakarta
WEBHOOK_URL=https://n8n.domain-anda.com/
N8N_HOST=n8n.domain-anda.com
N8N_PROTOCOL=https
N8N_PORT=5678

# ─── Telegram ─────────────────────────────────────────────────────────────
# Token dari @BotFather, bentuk: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=<TOKEN_DARI_BOTFATHER>
# Chat ID admin (angka, untuk grup biasanya negatif)
TELEGRAM_ADMIN_CHAT_ID=<CHAT_ID_ADMIN>

# ─── Google Sheets ────────────────────────────────────────────────────────
# Spreadsheet "Database Carousel" (tab: Carousel)
CAROUSEL_SHEET_ID=ID_SPREADSHEET_ANDA
# Spreadsheet "Arsip Carousel" (tab: Sheet1)
ARCHIVE_SHEET_ID=ID_SPREADSHEET_ARSIP_ANDA

# ─── Google Gemini ────────────────────────────────────────────────────────
GEMINI_API_KEY=API_KEY_DARI_AI_STUDIO
GEMINI_MODEL=models/gemini-3.1-flash-lite

# ─── Gambar ───────────────────────────────────────────────────────────────
IMGBB_API_KEY=API_KEY_IMGBB_ANDA
NVIDIA_API_KEY=<API_KEY_NVIDIA>

# ─── Posting Instagram ────────────────────────────────────────────────────
# Pilih salah satu penyedia, tidak perlu keduanya.

# Composio (workflow 4)
COMPOSIO_API_KEY=API_KEY_COMPOSIO_ANDA
COMPOSIO_CONNECTED_ACCOUNT_ID=ID_AKUN_TERHUBUNG
IG_USER_ID=INSTAGRAM_BUSINESS_USER_ID
IG_USERNAME=akun_utama

# Zernio (workflow 5)
ZERNIO_API_KEY=<API_KEY_ZERNIO>

# ─── Lain-lain ────────────────────────────────────────────────────────────
# Watermark default pada setiap slide
CAROUSEL_WATERMARK=@akun_anda
