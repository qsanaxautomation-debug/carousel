    {
      "parameters": {
        "jsCode": "const row = $input.first().json;\nconst style = 'Instagram carousel slide, square 1:1, flat vector illustration, deep blue and white palette with orange accents, clean modern infographic design, high contrast, generous margins.';\nconst out = [];\nfunction add(no, label, title, body) {\n  const t = String(title || '').trim();\n  const b = String(body || '').trim();\n  if (!t && !b) return;\n  const prompt = style + ' Bold sans-serif title text at the top reading exactly: \"' + t + '\". Illustration that visually represents: ' + (b || t) + '. Overall carousel topic: ' + String(row.topic || '') + '.';\n  out.push({ json: { row_id: row.id, slide_no: no, label: label, title: t, body: b, prompt: prompt } });\n}\nadd(0, 'cover', row.cover_title, row.cover_subtitle);\nfor (let i = 1; i <= 10; i++) {\n  const n = String(i).padStart(2, '0');\n  add(i, 'slide_' + n, row['slide_' + n + '_title'], row['slide_' + n + '_body']);\n}\nreturn out;"
      },
