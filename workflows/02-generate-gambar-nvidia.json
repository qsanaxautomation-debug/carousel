      "id": "68fa1955-9b4d-4773-afc4-8188c3f08f70",
      "name": "Ubah Base64 ke Gambar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1456,
        304
      ],
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  const b64 = (j.artifacts && j.artifacts[0] && j.artifacts[0].base64) || j.image || (j.data && j.data[0] && j.data[0].b64_json);\n  if (!b64) {\n    throw new Error('Respons NVIDIA tidak berisi gambar: ' + JSON.stringify(j).slice(0, 300));\n  }\n  const bin = await this.helpers.prepareBinaryData(Buffer.from(b64, 'base64'), 'slide.jpg', 'image/jpeg');\n  out.push({ json: {}, binary: { data: bin } });\n}\nreturn out;"
      }
    }
