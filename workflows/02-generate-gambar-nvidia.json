    {
      "parameters": {
        "jsCode": "const rowId = $('Batasi 1 Baris').first().json.id;\nconst uploads = $input.first().json.uploads || [];\nconst urls = uploads.map(u => (u.data && u.data.url) || u.url).filter(Boolean);\nif (!urls.length) {\n  throw new Error('Tidak ada URL gambar yang berhasil diunggah untuk baris ' + rowId);\n}\nreturn [{ json: { id: rowId, image_urls: urls.join(', '), jumlah_gambar: urls.length } }];"
      },
