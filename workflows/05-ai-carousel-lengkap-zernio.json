      "parameters": {
        "jsCode": "const accounts = $('Ambil Akun Instagram Zernio').first().json.accounts || [];\nif (!accounts.length) {\n  throw new Error('Tidak ada akun Instagram yang terhubung di Zernio. Hubungkan dulu akun Instagram di dashboard Zernio.');\n}\nconst accountId = accounts[0]._id;\nconst images = $('Kumpulkan Semua URL Gambar').first().json.all_images || [];\nconst mediaItems = images\n  .map(i => ({ type: 'image', url: i.data?.url || i.url }))\n  .filter(m => m.url);\nconst caption = $('AI Agent Pembuat Carousel').first().json.output.caption || '';\nconst chatId = $('Parse Input Telegram').first().json.chat_id;\nreturn [{ json: { chat_id: chatId, caption, mediaItems, accountId } }];"
      },
