    {
      "id": "d027ef40-996a-45f3-a476-b05b5bd9031d",
      "name": "Siapkan Baris Sheet",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        720
      ],
      "parameters": {
        "jsCode": "const out = $('AI Agent Pembuat Carousel').first().json.output || {};\nconst slides = out.slides || [];\nconst closing = out.closing_slide || {};\nconst input = $('Parse Input Telegram').first().json;\nconst now = $now.setZone('Asia/Jakarta');\n\n// Tags diambil dari hashtag di caption (fallback: closing_slide.hashtags jika ada)\nconst tagSource = String(out.caption || '') + ' ' + String(closing.hashtags || '');\nconst found = tagSource.match(/#[\\p{L}\\p{N}_]+/gu) || [];\nconst tags = [...new Set(found.map(t => t.replace(/^#/, '')))].slice(0, 4).join(', ');\n\nconst row = {\n  id: 'CRS-' + now.toFormat('yyyyMMdd-HHmmss'),\n  status: 'pending',\n  topic: input.raw_text || '',\n  cover_title: out.title || '',\n  cover_subtitle: out.hook || '',\n  tags,\n};\n\n// Template memuat maksimal 10 slide isi. Sisakan 1 slot untuk closing.\nconst content = slides.slice(0, 9).map(s => ({ title: s.headline || '', body: s.body_text || '', highlight: '' }));\nif (closing.headline || closing.cta) {\n  content.push({ title: closing.headline || '', body: closing.cta || '', highlight: '' });\n}\n\nfor (let i = 1; i <= 10; i++) {\n  const n = String(i).padStart(2, '0');\n  const s = content[i - 1] || {};\n  row['slide_' + n + '_title'] = s.title || '';\n  row['slide_' + n + '_body'] = s.body || '';\n  row['slide_' + n + '_highlight'] = s.highlight || '';\n}\n\nrow.caption = out.caption || '';\nrow.scheduled_at = '';\nrow.instagram_post_id = '';\nrow.published_at = '';\nrow.image_urls = '';\n\nreturn [{ json: row }];"
      }
    },
